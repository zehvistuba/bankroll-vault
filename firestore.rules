rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Usuário pode escrever qualquer campo EXCETO subscription (gerenciado pelo backend)
      allow write: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription']);

      // Permite criar documento inicial sem subscription
      allow create: if request.auth != null && request.auth.uid == userId;

      match /bets/{betId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /publicProfiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
