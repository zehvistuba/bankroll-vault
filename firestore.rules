rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Usuário pode escrever seus próprios campos EXCETO subscription e isAdmin
      // fcmToken é permitido (atualização de token push pelo cliente)
      allow write: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription', 'isAdmin']);

      // Permite criar documento inicial — bloqueia campos privilegiados na criação
      allow create: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['isAdmin', 'subscription']);

      // Admin pode escrever qualquer campo de qualquer usuário
      allow write: if isAdmin();

      match /bets/{betId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    match /publicProfiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Bolão privado — só o dono lê/escreve
    match /boloes/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Bolão público compartilhável — qualquer um lê, só o dono escreve
    match /publicBoloes/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Escrito apenas por Cloud Functions (server-side) — nenhum acesso de cliente
    match /processedWebhooks/{docId} {
      allow read, write: if false;
    }

    // pendingSubscriptions: escrito por Cloud Functions, sem acesso de cliente
    match /pendingSubscriptions/{docId} {
      allow read, write: if false;
    }
  }
}
