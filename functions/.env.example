# Variáveis de configuração do Firebase Functions
# Copie para .env.local e preencha com valores reais (não commitar .env.local)

# Lista de emails que recebem PRO no bootstrap (separados por vírgula)
BOOTSTRAP_PREMIUM_EMAILS=admin@exemplo.com,outro@exemplo.com

# Lista de emails que recebem isAdmin=true no bootstrap (subconjunto de PREMIUM)
BOOTSTRAP_ADMIN_EMAILS=admin@exemplo.com
